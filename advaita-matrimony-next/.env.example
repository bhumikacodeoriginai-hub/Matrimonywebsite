# Laravel API roots. Keep the existing API contract unchanged.
# Server-only Laravel API root for local development. The preview account is
# seeded into this local API, not the hosted production database.
ADVAITA_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public fallback for deployments that do not set ADVAITA_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://advaitamatrimony.com/api/v1

# Local UI preview only. Keep disabled in production; the credentials are used
# only to prefill the real password-login form after a local Laravel seed.
NEXT_PUBLIC_ENABLE_PREVIEW_LOGIN=false
NEXT_PUBLIC_PREVIEW_LOGIN_EMAIL=preview@advaita.test
NEXT_PUBLIC_PREVIEW_LOGIN_PASSWORD=Advaita2026!
